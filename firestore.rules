rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.id is string && isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
             data.role in ['content', 'design'] &&
             data.createdAt is string && data.createdAt.size() <= 40 &&
             (!('avatarColor' in data) || (data.avatarColor is string && data.avatarColor.size() <= 100)) &&
             (!('isCreativeDirector' in data) || (data.isCreativeDirector is bool)) &&
             (!('creativeDirectorId' in data) || (data.creativeDirectorId is string && data.creativeDirectorId.size() <= 128)) &&
             (!('clickupApiKey' in data) || (data.clickupApiKey is string && data.clickupApiKey.size() <= 200)) &&
             (!('selectedClickupSpaceId' in data) || (data.selectedClickupSpaceId is string && data.selectedClickupSpaceId.size() <= 100)) &&
             (!('selectedClickupSpaceName' in data) || (data.selectedClickupSpaceName is string && data.selectedClickupSpaceName.size() <= 200)) &&
             (!('clickupUserId' in data) || (data.clickupUserId is string && data.clickupUserId.size() <= 64)) &&
             (!('clickupUsername' in data) || (data.clickupUsername is string && data.clickupUsername.size() <= 100));
    }

    function isValidTask(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && isValidId(data.userId) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.cognitiveLoad in ['low', 'medium', 'high'] &&
             data.status in ['pipeline', 'todo', 'in_progress', 'in_review', 'done', 'archived'] &&
             data.order is number &&
             data.createdAt is string && data.createdAt.size() <= 40 &&
             data.updatedAt is string && data.updatedAt.size() <= 40 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 3000)) &&
             (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 30)) &&
             (!('completedAt' in data) || (data.completedAt is string && data.completedAt.size() <= 40)) &&
             (!('inProgressStartedAt' in data) || (data.inProgressStartedAt is string && data.inProgressStartedAt.size() <= 40)) &&
             (!('inProgressDurationMs' in data) || (data.inProgressDurationMs is number)) &&
             (!('activityLog' in data) || (data.activityLog is list)) &&
             (!('clickupTaskId' in data) || (data.clickupTaskId is string && data.clickupTaskId.size() <= 100)) &&
             (!('clickupFolderId' in data) || (data.clickupFolderId is string && data.clickupFolderId.size() <= 100)) &&
             (!('clickupFolderName' in data) || (data.clickupFolderName is string && data.clickupFolderName.size() <= 200)) &&
             (!('clickupListId' in data) || (data.clickupListId is string && data.clickupListId.size() <= 100)) &&
             (!('clickupListName' in data) || (data.clickupListName is string && data.clickupListName.size() <= 200)) &&
             (!('clickupSpaceId' in data) || (data.clickupSpaceId is string && data.clickupSpaceId.size() <= 100)) &&
             (!('clickupUrl' in data) || (data.clickupUrl is string && data.clickupUrl.size() <= 500)) &&
             (!('clickupTaskType' in data) || (data.clickupTaskType is string && data.clickupTaskType.size() <= 100)) &&
             (!('clickupTaskTypeId' in data) || (data.clickupTaskTypeId is string && data.clickupTaskTypeId.size() <= 64)) &&
             (!('clickupTaskTypeFieldId' in data) || (data.clickupTaskTypeFieldId is string && data.clickupTaskTypeFieldId.size() <= 64)) &&
             (!('parentTaskId' in data) || (data.parentTaskId is string && data.parentTaskId.size() <= 100)) &&
             (!('parentTaskTitle' in data) || (data.parentTaskTitle is string && data.parentTaskTitle.size() <= 300)) &&
             (!('clickupParentTaskId' in data) || (data.clickupParentTaskId is string && data.clickupParentTaskId.size() <= 100)) &&
             (!('isSubtask' in data) || (data.isSubtask is bool));
    }

    // Users collection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create: if isValidId(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if isValidId(userId) && isValidUser(incoming());
      allow delete: if isValidId(userId);
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow get: if isValidId(taskId);
      allow list: if true;
      allow create: if isValidId(taskId) && isValidTask(incoming()) && incoming().id == taskId;
      allow update: if isValidId(taskId) && isValidTask(incoming());
      allow delete: if isValidId(taskId);
    }

    // Compliance Audit Logs collection (SOC2 audit trail)
    match /compliance_audit_logs/{logId} {
      allow get, list: if true;
      allow create, update: if isValidId(logId);
    }
  }
}

