// All app data is served by the authenticated ZenFlow backend via Admin SDK (IAM bypasses rules).
// Direct client access is denied unconditionally across every collection.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /tasks/{taskId} {
      allow read, write: if false;
    }

    match /parent_tasks/{parentId} {
      allow read, write: if false;
    }

    match /compliance_audit_logs/{logId} {
      allow read, write: if false;
    }
  }
}
