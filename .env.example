# APP_URL: The URL where this applet is hosted.
APP_URL=

# Railway & Production Server Configuration
PORT=3000
NODE_ENV=production

# Firebase Service Account Key (JSON string, base64, or file path) for zen-flow Firestore
FIREBASE_SERVICE_ACCOUNT_KEY=

# Optional persistent volume for local store, audit log and private webhook registry.
# Cloud persistence uses Firebase Admin; unauthenticated Web SDK fallback is disabled.
ZENFLOW_DATA_DIR=

# Optional AES-256-GCM secret key for encrypting stored ClickUp PATs at rest
ZENFLOW_SECRETS_KEY=

# Optional Superadmin email override (defaults to kiran.s@zensciences.com when unset)
ZENFLOW_SUPERADMIN_EMAIL=
VITE_SUPERADMIN_EMAIL=
