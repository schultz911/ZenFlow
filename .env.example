# APP_URL: The URL where this applet is hosted.
APP_URL=

# Railway & Production Server Configuration
PORT=3000
NODE_ENV=production

# Firebase Service Account Key (JSON string, base64, or file path) for zen-flow Firestore
FIREBASE_SERVICE_ACCOUNT_KEY=

# Existing Firestore storage target. Google identity trust remains zen-flow-7173d.
FIREBASE_PROJECT_ID=zen-flow-7173d
FIREBASE_DATABASE_ID=(default)
