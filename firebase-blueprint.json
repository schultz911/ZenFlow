{
  "entities": {
    "User": {
      "title": "User",
      "description": "Team member profile in zenFlow",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique user ID"
        },
        "name": {
          "type": "string",
          "description": "Full name of the team member"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the team member"
        },
        "role": {
          "type": "string",
          "enum": ["content", "design"],
          "description": "Team swimlane role"
        },
        "avatarColor": {
          "type": "string",
          "description": "Tailwind gradient class for avatar background"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp ISO string"
        },
        "isCreativeDirector": {
          "type": "boolean",
          "description": "Whether this user is a designated Creative Director"
        },
        "creativeDirectorId": {
          "type": "string",
          "description": "ID of the Creative Director this user is mapped to"
        },
        "clickupApiKey": {
          "type": "string",
          "description": "Personal ClickUp API Token"
        },
        "selectedClickupSpaceId": {
          "type": "string",
          "description": "Active ClickUp space ID"
        },
        "selectedClickupSpaceName": {
          "type": "string",
          "description": "Active ClickUp space name"
        },
        "clickupUserId": {
          "type": "string",
          "description": "Mapped ClickUp Member ID"
        },
        "clickupUsername": {
          "type": "string",
          "description": "Mapped ClickUp Username"
        }
      },
      "required": ["id", "name", "email", "role", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "Kanban task item assigned to a user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique task ID"
        },
        "userId": {
          "type": "string",
          "description": "ID of the assigned user"
        },
        "title": {
          "type": "string",
          "description": "Title of the task"
        },
        "description": {
          "type": "string",
          "description": "Optional detailed task description"
        },
        "dueDate": {
          "type": "string",
          "description": "Optional due date in YYYY-MM-DD format"
        },
        "cognitiveLoad": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Cognitive workload level"
        },
        "status": {
          "type": "string",
          "enum": ["pipeline", "retainer", "todo", "in_progress", "in_review", "done", "archived"],
          "description": "Current status in the workflow"
        },
        "order": {
          "type": "number",
          "description": "Order index within the user status column"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Completion timestamp ISO string"
        },
        "inProgressStartedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when task entered in_progress status"
        },
        "inProgressDurationMs": {
          "type": "number",
          "description": "Total accumulated duration in milliseconds spent in in_progress"
        },
        "activityLog": {
          "type": "array",
          "description": "Audit trail of task lifecycle state transitions and assignments"
        },
        "clickupTaskId": {
          "type": "string",
          "description": "Associated ClickUp task ID"
        },
        "clickupFolderId": {
          "type": "string",
          "description": "Associated ClickUp folder ID"
        },
        "clickupFolderName": {
          "type": "string",
          "description": "Associated ClickUp folder name"
        },
        "clickupListId": {
          "type": "string",
          "description": "Associated ClickUp list ID"
        },
        "clickupListName": {
          "type": "string",
          "description": "Associated ClickUp list name"
        },
        "clickupSpaceId": {
          "type": "string",
          "description": "Associated ClickUp space ID"
        },
        "clickupUrl": {
          "type": "string",
          "description": "URL to the task on ClickUp"
        },
        "clickupTaskType": {
          "type": "string",
          "description": "Selected ClickUp Task Type name"
        },
        "clickupTaskTypeId": {
          "type": "string",
          "description": "Selected ClickUp Task Type custom field option ID"
        },
        "clickupTaskTypeFieldId": {
          "type": "string",
          "description": "ClickUp Task Type custom field ID"
        },
        "parentTaskId": {
          "type": "string",
          "description": "Source parent task ID if this task is a subtask"
        },
        "parentTaskTitle": {
          "type": "string",
          "description": "Source parent task title for display"
        },
        "clickupParentTaskId": {
          "type": "string",
          "description": "Associated parent ClickUp task ID"
        },
        "isSubtask": {
          "type": "boolean",
          "description": "Whether this task is a subtask of another task"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp ISO string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last updated timestamp ISO string"
        }
      },
      "required": ["id", "userId", "title", "cognitiveLoad", "status", "order", "createdAt", "updatedAt"]
    },
    "AuditLogEntry": {
      "title": "AuditLogEntry",
      "description": "SOC2 append-only immutable audit trail record",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique audit entry ID"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the audit event occurred"
        },
        "category": {
          "type": "string",
          "enum": ["task", "user", "security", "webhook", "system"],
          "description": "Event classification category"
        },
        "action": {
          "type": "string",
          "description": "Specific action identifier"
        },
        "targetId": {
          "type": "string",
          "description": "ID of the target entity"
        },
        "targetType": {
          "type": "string",
          "enum": ["task", "user", "workspace", "webhook"],
          "description": "Type of the target entity"
        },
        "details": {
          "type": "string",
          "description": "Human-readable narrative description of the event"
        },
        "actor": {
          "type": "object",
          "description": "User or service entity performing the action"
        },
        "metadata": {
          "type": "object",
          "description": "Structured contextual metadata payload"
        }
      },
      "required": ["id", "timestamp", "category", "action", "targetId", "targetType"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of team members"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Collection of workflow tasks"
    },
    "/compliance_audit_logs/{logId}": {
      "schema": "AuditLogEntry",
      "description": "Append-only immutable audit trail for SOC2 compliance"
    }
  }
}
